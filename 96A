#include<stdio.h>
#include<string.h>

int main(){
    char s[105];
    scanf("%s", s);
    int n = strlen(s);
    int count = 1;
    int flag = 0;

    for(int i = 0;i<n;i++){
        if(s[i] == s[i-1]){
            count++;
            if(count>=7){
                flag = 1;
                break;
            }
        }else{
            count = 1;
        }
    }
    if(flag){
        printf("YES\n");
    }else{
        printf("NO\n");
    }
    return 0;
}
